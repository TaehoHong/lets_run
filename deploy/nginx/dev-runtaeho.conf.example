# Include from the nginx http context. Render the delivery token from protected server configuration.
# Never commit the rendered file: the webhook path and query contain the same delivery secret.
log_format runtaeho_private '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status $body_bytes_sent';
log_format runtaeho_webhook '$remote_addr - [$time_local] '
                            '"$request_method /api/v1/garmin/webhook $server_protocol" $status $body_bytes_sent';

server {
        listen 443 ssl;
        listen [::]:443 ssl;
        listen 12643 ssl;
        listen [::]:12643 ssl;

        server_name dev-api-run-taeho.com;
        server_tokens off;
        client_header_timeout 10s;
        client_body_timeout 30s;
        access_log /var/log/nginx/runtaeho.access.log runtaeho_private;

        ssl_certificate /etc/letsencrypt/live/dev-api-run-taeho.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/dev-api-run-taeho.com/privkey.pem;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        # Garmin preserves URL paths but drops query parameters from saved endpoints.
        # Keep the application receiver's existing delivery-token authentication.
        location = /api/v1/garmin/webhook/__GARMIN_WEBHOOK_TOKEN__ {
                access_log /var/log/nginx/runtaeho.webhook.access.log runtaeho_webhook;
                error_log /dev/null;
                client_max_body_size 32m;
                set $args "token=__GARMIN_WEBHOOK_TOKEN__";
                rewrite ^ /api/v1/garmin/webhook break;
                proxy_pass http://127.0.0.1:12642;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Host $http_host;
        }

        # Unknown or mistyped secret paths must neither reach the app nor appear in logs.
        location ^~ /api/v1/garmin/webhook/ {
                access_log /var/log/nginx/runtaeho.webhook.access.log runtaeho_webhook;
                error_log /dev/null;
                return 404;
        }

        location = /api/v1/garmin/webhook {
                access_log /var/log/nginx/runtaeho.webhook.access.log runtaeho_webhook;
                error_log /dev/null;
                client_max_body_size 32m;
                proxy_pass http://127.0.0.1:12642;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Host $http_host;
        }

        location = /api/v1/running/completed-records {
                client_max_body_size 32m;
                proxy_pass http://127.0.0.1:12642;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Host $http_host;
        }

        location / {
                proxy_pass http://127.0.0.1:12642;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Host $http_host;
        }
}
