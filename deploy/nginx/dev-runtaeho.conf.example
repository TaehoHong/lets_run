server {
        listen 12643 ssl;
        listen [::]:12643 ssl;

        server_name dev-api-run-taeho.com;

        ssl_certificate /etc/letsencrypt/live/dev-api-run-taeho.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/dev-api-run-taeho.com/privkey.pem;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        location / {
                proxy_pass http://127.0.0.1:12642;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Host $http_host;
        }
}
